<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Joku’s joppin spudinki</title>
    <style>
        body {
            margin: 0; background-color: #111; color: white;
            display: flex; flex-direction: column; align-items: center; justify-content: center;
            height: 100vh; font-family: 'Comic Sans MS', cursive, sans-serif;
            touch-action: none; user-select: none;
        }
        #gameCanvas {
            background-color: #fceecb; border: 5px solid #ff9800; border-radius: 15px;
            max-width: 100%; max-height: 75vh; box-shadow: 0 0 30px rgba(255, 152, 0, 0.5);
        }
        #ui { margin-top: 15px; text-align: center; }
        .controls { font-size: 14px; color: #ccc; margin-top: 10px; }
    </style>
</head>
<body>

    <h1 style="margin: 5px; color: #ffeb3b; text-shadow: 2px 2px #d32f2f;">Joku’s joppin spudinki</h1>
    <canvas id="gameCanvas" width="800" height="450"></canvas>
    
    <div id="ui">
        <div class="controls">
            <b>Управление ПК:</b> Клавиши <b>Q</b> (Вверх-Влево), <b>A</b> (Вниз-Влево), <b>P</b> (Вверх-Вправо), <b>L</b> (Вниз-Вправо).<br>
            <b>Телефон:</b> Нажимай на 4 угла экрана.<br>
            🔥 <i>Не лови горячую картошку! Пусть падает!</i> 🔥
        </div>
    </div>

<script>
    const canvas = document.getElementById('gameCanvas');
    const ctx = canvas.getContext('2d');

    // Загрузка картинок
    const images = {
        catcher: new Image(),
        catcherAngry: new Image(),
        throwerLeft: new Image(),
        throwerRight: new Image()
    };
    
    // ПУТИ К ТВОИМ КАРТИНКАМ
    images.catcher.src = 'catcher.png';
    images.catcherAngry.src = 'catcher_angry.png';
    images.throwerLeft.src = 'thrower_left.png';
    images.throwerRight.src = 'thrower_right.png';

    // Состояния игры
    let playerPos = 1; // 0: Верх-Лево, 1: Низ-Лево, 2: Верх-Право, 3: Низ-Право
    let score = 0;
    let lives = 3;
    let spudinkis = []; // Массив падающей картошки
    
    let spawnRate = 2000;
    let speed = 0.5;
    let gameOver = false;
    let lastTime = 0;
    let lastSpawn = 0;
    let angryTimer = 0; // Таймер для красного лица

    // Позиции лотков (откуда катится картошка)
    const chutes = [
        { startX: 120, startY: 100, endX: 300, endY: 180 }, // 0: Верх Лево
        { startX: 120, startY: 280, endX: 300, endY: 360 }, // 1: Низ Лево
        { startX: 680, startY: 100, endX: 500, endY: 180 }, // 2: Верх Право
        { startX: 680, startY: 280, endX: 500, endY: 360 }  // 3: Низ Право
    ];

    function drawImage(img, x, y, width, height, fallbackText) {
        if (img.complete && img.naturalHeight !== 0) {
            ctx.drawImage(img, x - width/2, y - height/2, width, height);
        } else {
            ctx.fillStyle = "black";
            ctx.font = "40px Arial";
            ctx.fillText(fallbackText, x, y);
        }
    }

    function update(deltaTime, time) {
        if (gameOver) return;

        // Таймер злого лица
        if (angryTimer > 0) angryTimer -= deltaTime;

        // Создание новой картошки
        if (time - lastSpawn > spawnRate) {
            let isHot = Math.random() < 0.25; // 25% шанс на горячую картошку
            spudinkis.push({ 
                pos: Math.floor(Math.random() * 4), 
                progress: 0,
                isHot: isHot
            });
            lastSpawn = time;
            if (spawnRate > 600) spawnRate -= 20; // Ускорение игры
            speed += 0.005;
        }

        // Движение картошки
        for (let i = spudinkis.length - 1; i >= 0; i--) {
            let s = spudinkis[i];
            s.progress += speed * deltaTime * 0.001;

            if (s.progress >= 1) {
                // Картошка достигла конца!
                if (playerPos === s.pos) {
                    if (s.isHot) {
                        // Поймал горячую - ПЛОХО
                        lives--;
                        angryTimer = 1500; // Злое лицо на 1.5 секунды
                    } else {
                        // Поймал обычную - ХОРОШО
                        score++;
                    }
                } else {
                    if (!s.isHot) {
                        // Уронил обычную - ПЛОХО
                        lives--;
                    }
                    // Если уронил горячую - ничего не происходит (молодец, увернулся)
                }
                spudinkis.splice(i, 1);

                if (lives <= 0) gameOver = true;
            }
        }
    }

    function draw() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);

        // Рисуем кидающих персонажей
        drawImage(images.throwerLeft, 60, 225, 120, 160, '🧌');
        drawImage(images.throwerRight, 740, 225, 100, 180, '👴');

        // Рисуем лотки (палки)
        ctx.lineWidth = 8;
        ctx.strokeStyle = '#8B4513';
        chutes.forEach(ch => {
            ctx.beginPath();
            ctx.moveTo(ch.startX, ch.startY);
            ctx.lineTo(ch.endX, ch.endY);
            ctx.stroke();
        });

        // Рисуем главного персонажа (ловца)
        let playerImg = (angryTimer > 0) ? images.catcherAngry : images.catcher;
        // Немного сдвигаем персонажа в сторону, где он ловит
        let px = 400, py = 260;
        if (playerPos === 0) { px = 350; py = 220; }
        if (playerPos === 1) { px = 350; py = 280; }
        if (playerPos === 2) { px = 450; py = 220; }
        if (playerPos === 3) { px = 450; py = 280; }
        drawImage(playerImg, px, py, 130, 170, (angryTimer > 0) ? '😡' : '🐸');

        // Рисуем картошку
        ctx.font = "30px Arial";
        ctx.textAlign = "center";
        ctx.textBaseline = "middle";
        spudinkis.forEach(s => {
            let ch = chutes[s.pos];
            let x = ch.startX + (ch.endX - ch.startX) * s.progress;
            let y = ch.startY + (ch.endY - ch.startY) * s.progress - 20; // чуть выше палки
            
            if (s.isHot) {
                ctx.fillText('🔥🥔', x, y); // Горячая картошка
            } else {
                ctx.fillText('🥔', x, y);   // Обычная картошка
            }
        });

        // Интерфейс (Очки и Жизни)
        ctx.fillStyle = 'black';
        ctx.font = 'bold 24px Arial';
        ctx.textAlign = 'left';
        ctx.fillText(`Счет: ${score}`, 20, 40);
        ctx.textAlign = 'right';
        ctx.fillText(`Жизни: ${'❤️'.repeat(Math.max(0, lives))}`, 780, 40);

        // Экран конца игры
        if (gameOver) {
            ctx.fillStyle = 'rgba(0,0,0,0.7)';
            ctx.fillRect(0, 0, canvas.width, canvas.height);
            ctx.fillStyle = 'white';
            ctx.font = '40px Arial';
            ctx.textAlign = 'center';
            ctx.fillText('ИГРА ОКОНЧЕНА!', 400, 200);
            ctx.font = '20px Arial';
            ctx.fillText('Кликни или нажми пробел, чтобы начать заново', 400, 250);
            drawImage(images.catcherAngry, 400, 350, 100, 130, '😡');
        }
    }

    function gameLoop(time) {
        let deltaTime = time - lastTime;
        lastTime = time;

        update(deltaTime, time);
        draw();

        if (!gameOver) {
            requestAnimationFrame(gameLoop);
        }
    }

    // --- УПРАВЛЕНИЕ ---

    function setPlayerPos(pos) {
        if (!gameOver) playerPos = pos;
    }

    function resetGame() {
        score = 0; lives = 3; spudinkis = [];
        spawnRate = 2000; speed = 0.5; gameOver = false; angryTimer = 0;
        lastSpawn = performance.now();
        requestAnimationFrame(gameLoop);
    }

    // Клавиатура
    window.addEventListener('keydown', (e) => {
        let key = e.key.toLowerCase();
        if (gameOver && (key === ' ' || key === 'enter')) resetGame();
        
        if (key === 'q' || key === 'й') setPlayerPos(0);
        if (key === 'a' || key === 'ф') setPlayerPos(1);
        if (key === 'p' || key === 'з') setPlayerPos(2);
        if (key === 'l' || key === 'д') setPlayerPos(3);
    });

    // Мышь / Тачскрин (для телефона)
    canvas.addEventListener('mousedown', handleTouch);
    canvas.addEventListener('touchstart', handleTouch, {passive: false});

    function handleTouch(e) {
        e.preventDefault(); // чтобы экран не скроллился
        if (gameOver) {
            resetGame();
            return;
        }
        let rect = canvas.getBoundingClientRect();
        let clientX = e.touches ? e.touches[0].clientX : e.clientX;
        let clientY = e.touches ? e.touches[0].clientY : e.clientY;
        let x = clientX - rect.left;
        let y = clientY - rect.top;

        let isLeft = x < rect.width / 2;
        let isTop = y < rect.height / 2;

        if (isLeft && isTop) setPlayerPos(0);
        if (isLeft && !isTop) setPlayerPos(1);
        if (!isLeft && isTop) setPlayerPos(2);
        if (!isLeft && !isTop) setPlayerPos(3);
    }

    // Старт игры
    images.catcher.onload = () => requestAnimationFrame(gameLoop);
    // На случай если картинки не прогрузятся (будут эмодзи)
    setTimeout(() => { if(lastTime === 0) requestAnimationFrame(gameLoop); }, 1000);

</script>
</body>
</html>
